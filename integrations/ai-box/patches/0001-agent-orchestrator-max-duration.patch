 - Body: Goal, Background, Requirements, Done Criteria, User Notes. Keep it task-specific — workdir, branch, commit/push/PR and report rules come from `templates/contract.md` plus `templates/delivery-<mode>.md`, appended automatically. To deviate (e.g. "analysis only, no PR"), say so in Requirements; the contract defers to the task.
 - Recurring tasks: write the goal so each run stands alone ("triage issues opened since the last run"). For knowledge tasks, say how the content should be organized (one file per topic, a dated changelog…) — the agent already knows to read what's there, update in place and keep `README.md` as the index.
 
diff --git a/context/skills/agent-orchestrator/bin/run-agent.sh b/context/skills/agent-orchestrator/bin/run-agent.sh
index d2b57de..5272281 100755
--- a/context/skills/agent-orchestrator/bin/run-agent.sh
+++ b/context/skills/agent-orchestrator/bin/run-agent.sh
@@ -2,7 +2,7 @@
 # run-agent.sh — start an agent in the background on a prepared run folder.
 #
 # Usage:
-#   run-agent.sh --agent claude|codex --run-dir RUN_DIR --workdir DIR
+#   run-agent.sh --agent claude|codex --run-dir RUN_DIR --workdir DIR [--max-duration 45m]
 #
 # Expects RUN_DIR/agent-task.md. Runs the agent inside DIR (the run's worktree or a
 # persistent workspace), detached, with the task on stdin and output in RUN_DIR/agent.log.
@@ -10,16 +10,19 @@
 # agent exits, and finalizes the run (finalize-run.sh) right after.
 #
 # Agents always run in unrestricted mode; there is no safe-mode switch.
+# --max-duration (a `timeout` duration: 90s, 45m, 2h) stops the agent when it runs longer;
+# its exit code is then 124 and the run is finalized as failed.
 
 . "$(dirname "$(readlink -f "$0")")/_lib.sh"
 
-AGENT="" RUN_DIR="" WORKDIR=""
+AGENT="" RUN_DIR="" WORKDIR="" MAX_DURATION=""
 while [[ $# -gt 0 ]]; do
   case "$1" in
     -a|--agent)   AGENT="$2"; shift 2 ;;
        --run-dir) RUN_DIR="$2"; shift 2 ;;
        --workdir) WORKDIR="$2"; shift 2 ;;
-    -h|--help)    sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
+       --max-duration) MAX_DURATION="$2"; shift 2 ;;
+    -h|--help)    sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
     *) die "unknown flag: $1" 2 ;;
   esac
 done
@@ -33,6 +36,13 @@ case "$AGENT" in
   codex)  CMD=(codex exec --dangerously-bypass-approvals-and-sandbox --json -) ;;
 esac
 
+if [[ -n "$MAX_DURATION" ]]; then
+  [[ "$MAX_DURATION" =~ ^[0-9]+(\.[0-9]+)?[smhd]?$ ]] || die "invalid --max-duration: $MAX_DURATION (e.g. 90s, 45m, 2h)" 2
+  need timeout
+  # SIGTERM at the limit, SIGKILL a minute later if the agent ignores it.
+  CMD=(timeout --kill-after=60 "$MAX_DURATION" "${CMD[@]}")
+fi
+
 # setsid gives the agent its own process group, so it outlives the caller (cron,
 # the orchestrating session) and `status.sh --kill` can stop all of it at once.
 DETACH=(nohup)
diff --git a/context/skills/agent-orchestrator/bin/run-task.sh b/context/skills/agent-orchestrator/bin/run-task.sh
