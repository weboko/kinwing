#!/usr/bin/env python3
"""A stand-in for `claude -p` used by tests: it follows a kinwing scheduled task the way a
real agent would (kw run begin → record something → kw run end → report), without an LLM.
It ignores every flag; the task arrives on stdin, as agent-orchestrator sends it."""
import os
import re
import subprocess
import sys
import time

task = sys.stdin.read()
begin = re.search(r"Run `(.+? run begin [^`]+)`", task).group(1)
run_dir = re.search(r"Run directory: `([^`]+)`", task).group(1)
workdir = re.search(r"Working directory: `([^`]+)`", task).group(1)
kw = begin.split(" run begin")[0]
topic = re.search(r"--topic (\S+)", begin).group(1)


def sh(cmd):
    return subprocess.run(cmd, shell=True, capture_output=True, text=True)


r = sh(begin)
lines = ["# Report", "", "- agent: fake claude", f"- kw run begin exit code: {r.returncode}"]
if r.returncode in (10, 11, 12):
    lines.append(f"- refused, nothing to do: {r.stderr.strip()}")
else:
    time.sleep(float(os.environ.get("FAKE_AGENT_SLEEP", "0")))
    sh(f'{kw} q add "Follow-up found at {time.time_ns()}?" --topic {topic} --origin gap')
    e = sh(f'{kw} run end --topic {topic} --summary "fake research run" --stop-reason questions-done --next "keep going"')
    lines.append(f"- run end: {e.stdout.strip()} {e.stderr.strip()}")
    sh(f'git -C "{workdir}" add -A && git -C "{workdir}" commit -qm "{topic}: fake run"')
open(os.path.join(run_dir, "report.md"), "w").write("\n".join(lines) + "\n")
print('{"type":"result","total_cost_usd":0.01,"num_turns":3,"duration_ms":1000,"usage":{"input_tokens":5,"output_tokens":7}}')
